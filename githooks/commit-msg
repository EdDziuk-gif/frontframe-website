#!/bin/bash
# FrontFrame commit-msg hook -- see DEPLOYMENT-SOP.md
# Rejects commit messages containing backticks, since backticks in a
# message typed inline with `git commit -m "..."` are live to the shell
# (command substitution) even inside double quotes, and can silently
# drop words from the message before git ever sees it (this happened for
# real: "the page-level `session` variable" lost the word "session").
# Messages written to a file and committed with `git commit -F file` are
# unaffected by this bug class, so this hook just forbids backticks
# outright rather than trying to detect how the message was authored.

MSG_FILE="$1"

if grep -q '`' "$MSG_FILE"; then
  echo ""
  echo "COMMIT REJECTED: commit message contains a backtick (\`)."
  echo ""
  echo "Backticks inside a commit message passed via 'git commit -m \"...\"'"
  echo "are interpreted by the shell as command substitution -- even inside"
  echo "double quotes -- and can silently drop words from your message."
  echo ""
  echo "Fix: remove the backtick(s), or use single quotes for code terms"
  echo "(e.g. 'session' instead of a backtick-quoted session). For a long"
  echo "or special-character message, write it to a file and commit with:"
  echo "  git commit -F /tmp/commit_msg.txt"
  echo ""
  exit 1
fi

# --- Formatting checks (standard git convention: short imperative
#     subject, blank line, then body) ---
SUBJECT=$(head -n1 "$MSG_FILE")
SUBJECT_STRIPPED=$(printf '%s' "$SUBJECT" | tr -d '[:space:]')

if [ -z "$SUBJECT_STRIPPED" ]; then
  echo ""
  echo "COMMIT REJECTED: subject line (first line) is empty."
  exit 1
fi

SUBJECT_LEN=${#SUBJECT}
if [ "$SUBJECT_LEN" -gt 72 ]; then
  echo ""
  echo "COMMIT REJECTED: subject line is $SUBJECT_LEN characters (max 72)."
  echo "Keep the first line short and specific; put details in the body"
  echo "below a blank line."
  exit 1
fi

case "$SUBJECT" in
  *.)
    echo ""
    echo "COMMIT REJECTED: subject line ends with a period -- remove it."
    exit 1
    ;;
esac

LINE_COUNT=$(wc -l < "$MSG_FILE" | tr -d ' ')
if [ "$LINE_COUNT" -gt 1 ]; then
  SECOND_LINE=$(sed -n '2p' "$MSG_FILE")
  SECOND_LINE_STRIPPED=$(printf '%s' "$SECOND_LINE" | tr -d '[:space:]')
  if [ -n "$SECOND_LINE_STRIPPED" ]; then
    echo ""
    echo "COMMIT REJECTED: line 2 must be blank, separating the subject"
    echo "from the body (standard git convention)."
    exit 1
  fi
fi

exit 0
