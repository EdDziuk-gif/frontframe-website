#!/bin/bash
# FrontFrame post-commit hook -- see DEPLOYMENT-SOP.md
# Runs immediately after a commit lands. Unlike pre-commit/commit-msg,
# this CANNOT block or undo anything -- the commit object already
# exists by the time this runs. Its job is purely informational: an
# early, automatic reminder of which deploy step the change you just
# committed will need, so you see it the moment you commit instead of
# only at push time (or not at all).

# First commit in a repo has no HEAD~1 -- nothing to diff, skip quietly.
if ! git rev-parse HEAD~1 >/dev/null 2>&1; then
  exit 0
fi

CHANGED=$(git diff --name-only HEAD~1 HEAD)
TOUCHES_WORKER=$(printf '%s\n' "$CHANGED" | grep -c '^worker/')
TOUCHES_FRONTEND=$(printf '%s\n' "$CHANGED" | grep -c '^public/')
SUBJECT=$(git log -1 --format=%s)

echo ""
echo "Committed: $SUBJECT"
if [ "$TOUCHES_WORKER" -gt 0 ]; then
  echo "  -> touches worker/: git push will NOT deploy this. Run"
  echo "     'cd worker && npm run deploy' when you're ready to ship it."
fi
if [ "$TOUCHES_FRONTEND" -gt 0 ]; then
  echo "  -> touches public/: will go live via Cloudflare Pages once pushed."
fi
if [ "$TOUCHES_WORKER" -eq 0 ] && [ "$TOUCHES_FRONTEND" -eq 0 ]; then
  echo "  -> no worker/ or public/ changes -- nothing to deploy from this commit."
fi
echo ""

exit 0
